#!/bin/sh
# Gradle bootstrap for the pinned distribution.
#
# No gradle-wrapper.jar is committed: third-party binaries are rejected by the
# repository gate. This script verifies the SHA-256 recorded in
# gradle-wrapper.properties before running Gradle, reusing an existing wrapper
# cache when available.
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"
if [ ! -f "$PROPS" ]; then
    echo "gradlew: missing $PROPS" >&2
    exit 1
fi

DIST_URL=$(sed -n 's/^distributionUrl=//p' "$PROPS" | tr -d '\r' | sed 's/\\:/:/g')
DIST_SHA=$(sed -n 's/^distributionSha256Sum=//p' "$PROPS" | tr -d '\r')
if [ -z "$DIST_URL" ] || [ -z "$DIST_SHA" ]; then
    echo "gradlew: incomplete wrapper pin in $PROPS" >&2
    exit 1
fi

DIST_FILE=$(basename "$DIST_URL")
DIST_VERSION=$(printf '%s' "$DIST_FILE" | sed -n 's/^gradle-\(.*\)-bin\.zip$/\1/p')
if [ -z "$DIST_VERSION" ]; then
    echo "gradlew: unsupported distribution name: $DIST_FILE" >&2
    exit 1
fi

GRADLE_USER_HOME=${GRADLE_USER_HOME:-$HOME/.gradle}
CACHE="$GRADLE_USER_HOME/wrapper/dists/gradle-$DIST_VERSION-bin"
if [ -d "$CACHE" ]; then
    for candidate in "$CACHE"/*/gradle-$DIST_VERSION/bin/gradle; do
        if [ -x "$candidate" ]; then
            exec "$candidate" -p "$APP_HOME" "$@"
        fi
    done
fi

DEST="${GUNGNIR_GRADLE_DIST_DIR:-$APP_HOME/build/gradle-dist}"
GRADLE_BIN="$DEST/gradle-$DIST_VERSION/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
    mkdir -p "$DEST"
    archive="$DEST/$DIST_FILE"
    if [ ! -f "$archive" ]; then
        if command -v curl >/dev/null 2>&1; then
            curl -fL --retry 3 -o "$archive" "$DIST_URL"
        elif command -v wget >/dev/null 2>&1; then
            wget -O "$archive" "$DIST_URL"
        else
            echo "gradlew: curl or wget is required to fetch $DIST_URL" >&2
            exit 1
        fi
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum "$archive" | awk '{print $1}')
    else
        actual=$(shasum -a 256 "$archive" | awk '{print $1}')
    fi
    if [ "$actual" != "$DIST_SHA" ]; then
        echo "gradlew: distribution checksum mismatch for $archive" >&2
        exit 1
    fi
    if command -v unzip >/dev/null 2>&1; then
        unzip -q -o "$archive" -d "$DEST"
    else
        python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' "$archive" "$DEST"
    fi
fi
exec "$GRADLE_BIN" -p "$APP_HOME" "$@"
