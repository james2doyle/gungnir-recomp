# =====================================================================
# .gitignore — IP guardrails (charter: docs/LEGAL.md; plan: .dex/plan.md T1)
# Rule of thumb: if it came out of a UMD, a PSP, a GPU driver package, or a
# build of game-derived code, it is ignored. Each block says WHY.
# tools/repository_check.py enforces this mechanically; CI runs it.
# Synthetic test fixtures are committed as TEXT sources (.S/.hex) and
# assembled at test time — no binary fixtures, so nothing here has to be
# carved open with allowlists.
# =====================================================================

# --- Game disc images & dumps (proprietary; user-supplied, local only) ---
# Includes the local game.chd sitting in this workdir.
*.[iI][sS][oO]
*.[cC][hH][dD]
*.[cC][sS][oO]
*.[zZ][sS][oO]
*.[pP][bB][pP]

# --- Console executables & modules (encrypted OR decrypted; both derive
#     from the game) ---
*.[eE][lL][fF]
*.[pP][rR][xX]
*.[bB][iI][nN]
*.[pP][mM][fF]
*.[sS][fF][oO]

# --- Game media/assets: audio, fonts, textures, archives ---
# .pgf is also Sony firmware font data (copyrighted) — never commit.
*.[aA][tT]3
*.[vV][aA][gG]
*.[gG][iI][mM]
*.[pP][gG][fF]
*.[dD][aA][rR]
*.[tT][pP][lL]

# --- Extracted game trees / virtual memory stick / save data ---
[pP][sS][pP]_[gG][aA][mM][eE]/
[iI][nN][sS][dD][iI][rR]/
game/
memstick/
savestates/

# --- Keys & credentials (PSP key files, keystores, private keys) ---
keys/
*psp*key*
pgd_keys.txt
*keystore*
*.[jJ][kK][sS]
*.[pP][eE][mM]
.env

# --- Third-party binary blobs: driver packages, build outputs ---
# Binaries enter via pinned source builds (cmake/Deps.cmake), never as blobs.
drivers/
*.[zZ][iI][pP]
*.[jJ][aA][rR]
*.[sS][oO]
*.[dD][lL][lL]
*.[dD][yY][lL][iI][bB]
*.[eE][xX][eE]
*.[aA][pP][kK]
*.[aA][aA][bB]

# --- Driver payloads in APK-facing paths (T10e) ---
# User-supplied driver zips/ICDs never enter APK assets or a source jniLibs
# tree. repository_check rejects these locations by path even if force-added;
# this block keeps them invisible to git in the first place.
android/app/src/main/assets/drivers/
android/app/src/main/jniLibs/

# --- Generated recompilation output (a derivative of the copyrighted
#     executable): AOT C/C++ units, analysis reports, manifests ---
generated/
build/
out/
analysis/
*_recomp*.c
*_recomp*.cpp
*_recomp*.h
*_recomp*.hpp
*_imports.toml

# --- Machine-local per-dump data (dump hashes, address pins) ---
# EBOOT sha256 pins etc. advertise a specific rip; they stay local (plan §7A.4).
profiles/*/local/

# --- Logs & traces (may embed game-derived addresses or text) ---
logs/
*.trace

# --- Android machine-local config (absolute toolchain paths) ---
# local.properties holds SDK/NDK paths; Gradle/Studio caches embed machine
# state and generated outputs. app/build/ is already covered by build/.
local.properties
.gradle/
.cxx/
.idea/
*.iml

# --- Tooling noise ---
__pycache__/
*.pyc

# --- .dex/ is TRACKED in this project, overriding the global gitignore ---
# The master plan (.dex/plan.md) is a repo document and the dex task store
# (.dex/tasks.jsonl) is in-repo by explicit configuration (state travels
# with the repository). Neither contains game data — they are covered by
# the same gate as every other file.
!.dex/
!.dex/**
