# name: vfpu_boot_gap
# sentinel: 0x0880F000
# sp: 0x0880C000
# mem: 0x08805000 = 
# digest: 0x08805000:0x08805110
#
# T5a: the VFPU forms the T6 boot found unlowered — VCrs, VBfy1/2,
# VT4444/5551/5650 and VI2UC/US/S. Inputs are loaded from memory, so every
# result below is hand-computed from the encoded operation, not from the
# implementation.
#
# +0x40 vcrs.q     {1,2,3,4} x {5,6,7,8} -> {14,15,6,32}
# +0x50 vbfy1.q    {1,2,3,4} -> {3,-1,7,-1}
# +0x60 vt5650.q   colors -> {0x07E0001F,0xFFFFF800,stale,stale}
# +0x70 vi2uc.q    0x7F800000,0x3F800000,0xFF800000,0x00FFFFFF -> 0x01007FFF
# +0x90 vbfy2.q    {1,2,3,4} -> {4,6,-2,-2}
# +0x100 vdet.p   {1,2} x {5,6} -> -4
# +0xA0 vt4444.q   colors -> {0x00F0F00F,0xFFFF0F00,stale,stale}
# +0xC0 vi2us.q    0x00008000,0x7FFF8000,0x00010000,0xFFFF0000 -> {0xFFFF0001,2}
# +0xD0 vi2s.q     same input -> {0x7FFF0000,0xFFFF0001}
# +0xE0 vt5551.q   colors -> {0x03E0801F,0xFFFFF800,stale,stale}
0x3C040880  # lui a0, 0x0880
0x34845000  # ori a0, a0, 0x5000
0xD8800000  # lv.q C000, 0x00(a0)
0xD8840010  # lv.q C004, 0x10(a0)
0x66848090  # vcrs.q S016, S000, S004
0xF8900040  # sv.q C016, 0x40(a0)
0xD8800020  # lv.q C000, 0x20(a0)
0xD0428088  # vbfy1.q S008, S000
0xF8880050  # sv.q C008, 0x50(a0)
0xD043808C  # vbfy2.q S012, S000
0xF88C0090  # sv.q C012, 0x90(a0)
0x67040098  # vdet.p S024, S000, S004
0xF8980100  # sv.q C024, 0x100(a0)
0xD8800030  # lv.q C000, 0x30(a0)
0xD05B8080  # vt5650.q S000, S000
0xF8800060  # sv.q C000, 0x60(a0)
0xD8800030  # lv.q C000, 0x30(a0)
0xD0598080  # vt4444.q S000, S000
0xF88000A0  # sv.q C000, 0xA0(a0)
0xD8800030  # lv.q C000, 0x30(a0)
0xD05A8080  # vt5551.q S000, S000
0xF88000E0  # sv.q C000, 0xE0(a0)
0xD8800080  # lv.q C000, 0x80(a0)
0xD0068088  # vzero.q S008
0xD03C8088  # vi2uc.q S008, S000
0xF8880070  # sv.q C008, 0x70(a0)
0xD88000B0  # lv.q C000, 0xB0(a0)
0xD0068090  # vzero.q S016
0xD03E8090  # vi2us.q S016, S000
0xF89000C0  # sv.q C016, 0xC0(a0)
0xD88000B0  # lv.q C000, 0xB0(a0)
0xD0068094  # vzero.q S020
0xD03F8094  # vi2s.q S020, S000
0xF89400D0  # sv.q C020, 0xD0(a0)
0x03E00008  # jr ra
0x00000000  # nop
